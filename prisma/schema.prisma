generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  senha         String
  nivelAcesso   NivelAcesso    @map("nivel_acesso")
  clientePerfil ClienteTabela?
  pedidos       Pedido[]
  tokens        Token[]

  @@map("usuarios")
}

model ClienteTabela {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  nome      String
  endereco  String
  telefone  String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos   Pedido[]

  @@map("clientes_tabela")
}

model Tipo {
  id      Int      @id @default(autoincrement())
  nome    String
  lanches Lanche[]

  @@map("tipos")
}

model Lanche {
  id          Int                @id @default(autoincrement())
  nome        String
  descricao   String?            @db.Text
  tipoId      Int                @map("tipo_id")
  preco       Decimal            @db.Decimal(10, 2)
  quantidade  Int
  tipo        Tipo               @relation(fields: [tipoId], references: [id])
  fotos       Foto[]
  pedidos     Pedido[]
  condimentos LancheCondimento[]

  @@map("lanches")
}

model Foto {
  id        Int     @id @default(autoincrement())
  lancheId  Int     @map("lanche_id")
  descricao String?
  url       String
  lanche    Lanche  @relation(fields: [lancheId], references: [id])

  @@map("fotos")
}

model Condimento {
  id      Int                @id @default(autoincrement())
  nome    String
  lanches LancheCondimento[]

  @@map("condimentos")
}

model LancheCondimento {
  id           Int        @id @default(autoincrement())
  lancheId     Int        @map("lanche_id")
  condimentoId Int        @map("condimento_id")
  lanche       Lanche     @relation(fields: [lancheId], references: [id])
  condimento   Condimento @relation(fields: [condimentoId], references: [id])

  @@map("lanche_condimentos")
}

model Pedido {
  id              Int           @id @default(autoincrement())
  lancheId        Int           @map("lanche_id")
  clienteTabelaId Int           @map("clientetabela_id")
  resposta        String?       @db.Text
  data            DateTime      @default(now())
  usuarioId       Int           @map("usuario_id")
  pagamento       Pagamento
  lanche          Lanche        @relation(fields: [lancheId], references: [id])
  clienteTabela   ClienteTabela @relation(fields: [clienteTabelaId], references: [id])
  admin           Usuario       @relation(fields: [usuarioId], references: [id])

  @@map("pedidos")
}

model Token {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  token     String    @unique
  tipoToken TipoToken
  criado    DateTime  @default(now())
  expira    DateTime
  revogado  Boolean   @default(false)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

enum Pagamento {
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  DINHEIRO
}

enum NivelAcesso {
  CLIENTE
  ADMIN
}

enum TipoToken {
  ATUALIZAR
  REDEFINIR_SENHA
  VALIDACAO_EMAIL
}