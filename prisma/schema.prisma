generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  senha         String
  nivelAcesso   NivelAcesso    @default(CLIENTE)
  clientePerfil ClienteTabela?
  pedidos       Pedido[]
  tokens        Token[]

  @@map("usuarios")
}

model ClienteTabela {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique @map("usuario_id")
  nome      String
  endereco  String
  telefone  String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos   Pedido[]

  @@map("clientes_tabela")
}

model Tipo {
  id    Int    @id @default(autoincrement())
  nome  String
  itens Item[]

  @@map("tipos")
}

model Item {
  id          Int                @id @default(autoincrement())
  nome        String
  descricao   String?            @db.Text
  tipoId      Int                @map("tipo_id")
  preco       Decimal            @db.Decimal(10, 2)
  disponivel  Boolean            @default(true)
  destaque   Boolean             @default(false)
  tipo        Tipo               @relation(fields: [tipoId], references: [id])
  fotos       Foto[]
  pedidos     PedidoItem[]
  condimentos LancheCondimento[]
  categoria   TipoItem           @default(LANCHE)

  @@map("itens")
}

model Foto {
  id        Int     @id @default(autoincrement())
  itemId    Int     @map("item_id")
  descricao String?
  url       String
  item      Item    @relation(fields: [itemId], references: [id])

  @@map("fotos")
}

model Condimento {
  id    Int                @id @default(autoincrement())
  nome  String
  itens LancheCondimento[]

  @@map("condimentos")
}

model LancheCondimento {
  id           Int        @id @default(autoincrement())
  itemId       Int        @map("item_id")
  condimentoId Int        @map("condimento_id")
  item         Item       @relation(fields: [itemId], references: [id])
  condimento   Condimento @relation(fields: [condimentoId], references: [id])

  @@unique([itemId, condimentoId])
  @@map("lanche_condimentos")
}

model Pedido {
  id              Int       @id @default(autoincrement())
  clienteTabelaId Int       @map("clientetabela_id")
  usuarioId       Int       @map("usuario_id")
  pagamento       Pagamento
  data            DateTime  @default(now())
  observacoes     String?   @db.Text
  entregue        Boolean   @default(false)

  itens         PedidoItem[]
  clienteTabela ClienteTabela @relation(fields: [clienteTabelaId], references: [id])
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
}

model PedidoItem {
  id         Int     @id @default(autoincrement())
  pedidoId   Int     @map("pedido_id")
  itemId     Int     @map("item_id")
  quantidade Int     @default(1)
  preco      Decimal @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])
}

model Token {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  token     String    @unique
  tipoToken TipoToken
  criado    DateTime  @default(now())
  expira    DateTime
  revogado  Boolean   @default(false)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

enum Pagamento {
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  DINHEIRO
}

enum NivelAcesso {
  CLIENTE
  ADMIN
}

enum TipoToken {
  ATUALIZAR
  REDEFINIR_SENHA
  VALIDACAO_EMAIL
}

enum TipoItem {
  LANCHE
  BEBIDA
}